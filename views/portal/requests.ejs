<%- include("../partials/head") %>
<%- include("../partials/nav") %>

<div class="page-head">
  <h1>My Portal</h1>
  <% if (requestsOn) { %>
  <div class="page-head-actions">
      Request Missing:
      <a class="btn" href="/portal/requests/new?kind=add">punch</a>
      <a class="btn" href="/portal/requests/new?kind=add_shift">shift</a>
  </div>
  <% } %>
</div>

<%- include("../partials/portal-tabs", { current: "requests" }) %>

<% const messages = {
  pending: "Request sent. A manager will review it.",
  applied: "Change applied.",
  modified: "Request updated. It's still waiting for a manager.",
  cancelled: "Request cancelled.",
}; %>
<% if (messages[submitted]) { %>
  <p class="alert alert-ok"><%= messages[submitted] %></p>
<% } %>
<% if (!requestsOn) { %>
  <p class="alert alert-warn">Punch edit requests are turned off. Talk to a manager about changes.</p>
<% } %>

<section class="card">
  <h2>Pending <span class="muted">(<%= pending.length %>)</span></h2>
  <% if (pending.length === 0) { %>
    <p class="muted">No pending requests. To ask for a change to a punch, use the links next to it on the My shifts tab.</p>
  <% } else { %>
    <%- include("../partials/request-groups", { groups: pendingGroups, own: true, showEmployee: false, requestsOn }) %>
  <% } %>
</section>

<section class="card">
  <h2>Past requests</h2>
  <% if (past.length === 0) { %>
    <p class="muted">Nothing reviewed or cancelled yet.</p>
  <% } else { %>
    <%- include("../partials/request-groups", { groups: pastGroups, own: true, showEmployee: false }) %>
  <% } %>
</section>

<%- include("../partials/foot") %>
