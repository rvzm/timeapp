<%- include("../partials/head") %>
<%- include("../partials/nav") %>

<div class="page-head">
  <h1>My Portal</h1>
  <div class="page-head-actions">
    <% if (requestsOn) { %>
      <a class="btn" href="/portal/requests/new?kind=add">Request a missing punch</a>
      <a class="btn" href="/portal/requests/new?kind=add_shift">Request a missing shift</a>
    <% } %>
    <a class="btn btn-primary" href="/portal/export?period=week&amp;date=<%= range.from %>">Export timesheet</a>
  </div>
</div>

<%- include("../partials/portal-tabs", { current: "shifts" }) %>

<section class="card">
  <form method="get" action="/portal" class="range-form">
    <label class="field">
      <span>From</span>
      <input type="date" name="from" value="<%= range.from %>">
    </label>
    <label class="field">
      <span>To</span>
      <input type="date" name="to" value="<%= range.to %>">
    </label>
    <button class="btn">Show</button>
    <a class="btn btn-ghost" href="/portal">This week</a>
    <a class="btn btn-ghost" href="/portal?from=<%= lastWeek.from %>&amp;to=<%= lastWeek.to %>">Last week</a>
  </form>

  <h2>
    Shifts
    <span class="muted">· <%= fmt.formatDay(range.from) %><% if (range.to !== range.from) { %> – <%= fmt.formatDay(range.to) %><% } %></span>
  </h2>

  <% if (shifts.length === 0) { %>
    <p class="muted">No shifts in this range.</p>
  <% } else { %>
    <p>
      Total worked: <strong><%= fmt.formatDuration(totalMs) %></strong>
      <% if (incomplete) { %>
        <span class="muted">(<%= incomplete %> shift<%= incomplete === 1 ? "" : "s" %> with a missing punch not counted)</span>
      <% } %>
    </p>
    <%- include("../partials/shifts", { shifts, mode: "portal", notesBack: `/portal?from=${range.from}&to=${range.to}` }) %>
  <% } %>
</section>

<%- include("../partials/foot") %>
