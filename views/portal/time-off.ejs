<%- include("../partials/head") %>
<%- include("../partials/nav") %>

<%# Asking to be let off one assigned shift. Needs `assignment`, `form`, `error`. %>
<p class="breadcrumb"><a href="/portal/schedule">← My schedule</a></p>

<section class="card">
  <h1>Request off</h1>
  <p class="muted">
    <%= settings.requestMode === "honor"
      ? "You'll be off this shift right away, and it will be logged."
      : "A manager will review your request. Until it's approved, you're still expected for this shift." %>
  </p>

  <p>
    Shift: <strong><%= fmt.formatRange(assignment.start_at, assignment.end_at) %></strong>
    <span class="muted">· assigned by <%= assignment.assigned_by_name %><% if (assignment.note) { %> · <%= assignment.note %><% } %></span>
  </p>

  <% if (error) { %>
    <p class="alert alert-error"><%= error %></p>
  <% } %>

  <form method="post" action="/portal/schedule/<%= assignment.id %>/off" class="form-grid">
    <label class="field field-wide">
      <span>Reason</span>
      <textarea name="reason" rows="3" maxlength="500" required placeholder="e.g. Doctor's appointment"><%= form.reason %></textarea>
    </label>

    <div class="form-actions field-wide">
      <button class="btn btn-primary">Send request</button>
      <a class="btn btn-ghost" href="/portal/schedule">Cancel</a>
    </div>
  </form>
</section>

<%- include("../partials/foot") %>
