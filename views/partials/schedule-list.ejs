<%# Assigned (mandatory) shifts with attendance badges.
    Needs `assignments` (with .attendance). Optional:
      `showName`  - show and link each employee's name
      `showHours` - show each shift's length
      `canDelete` - function(assignment) -> true to show a Remove button, which returns to `back`
      `timeOff`   - the employee's own schedule: a Request off button, or the request's status
                    (needs `requestsOn`) %>
<ul class="schedule-list">
  <% assignments.forEach((a) => { %>
    <li class="schedule-item">
      <div>
        <% if (locals.showName) { %>
          <a href="/manage/employees/<%= a.user_id %>/schedule"><strong><%= a.user_name %></strong></a> ·
        <% } %>
        <span><%= fmt.formatRange(a.start_at, a.end_at) %></span>
        <% if (locals.showHours) { %>
          <span class="muted">· <%= fmt.formatDuration(Date.parse(a.end_at) - Date.parse(a.start_at)) %></span>
        <% } %>
        <div class="muted small">
          Assigned by <%= a.assigned_by_name %><% if (a.note) { %> · <%= a.note %><% } %>
        </div>
      </div>
      <div class="schedule-badges">
        <%- include("attendance", { attendance: a.attendance, hideOff: Boolean(locals.timeOff) }) %>
        <% if (locals.timeOff) { %>
          <%- include("time-off-status", { a, requestsOn }) %>
        <% } %>
        <% if (locals.canDelete && canDelete(a)) { %>
          <form method="post" action="/manage/schedule/<%= a.id %>/delete" class="inline"
                data-question="Remove this assigned shift?" onsubmit="return confirm(this.dataset.question)">
            <input type="hidden" name="back" value="<%= back %>">
            <button class="btn btn-small btn-ghost-danger">Remove</button>
          </form>
        <% } %>
      </div>
    </li>
  <% }) %>
</ul>
