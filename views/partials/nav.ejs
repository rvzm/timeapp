<% const currentUser = locals.user; const currentPath = locals.path || ""; %>
<%# The site broadcast. Always here so /broadcast.js has something to fill in when one
    starts while the page is open; empty and hidden until then. %>
<div class="broadcast" id="broadcast" data-id="<%= locals.broadcast ? broadcast.id : "" %>"<%- locals.broadcast ? "" : " hidden" %>>
  <p class="broadcast-message"><%= locals.broadcast ? broadcast.message : "" %></p>
</div>
<script src="/broadcast.js" defer></script>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/"><%= appConfig.name %></a>

    <nav class="topbar-links">
      <% if (currentUser) { %>
        <a href="/clock"<%- currentPath === "/clock" ? ' aria-current="page"' : "" %>>Clock</a>
        <a href="/portal"<%- currentPath.startsWith("/portal") ? ' aria-current="page"' : "" %>>My Portal</a>
        <% if (isManagerOrAdmin(currentUser)) { %>
          <a href="/manage"<%- currentPath.startsWith("/manage") ? ' aria-current="page"' : "" %>>Manage<% if (locals.pendingRequestCount) { %> <span class="nav-count" title="Pending requests"><%= pendingRequestCount %></span><% } %></a>
        <% } %>
        <% if (isAdmin(currentUser)) { %>
          <a href="/admin"<%- currentPath.startsWith("/admin") ? ' aria-current="page"' : "" %>>Admin</a>
        <% } %>
      <% } %>
    </nav>

    <div class="topbar-actions">
      <% if (currentUser) { %>
        <% if (isAdmin(currentUser)) { %>
          <%# Both buttons are rendered, one hidden: /broadcast.js swaps them when another
              admin starts or dismisses a broadcast, so the page needn't reload. %>
          <form method="post" action="/broadcast" class="broadcast-control" data-broadcast-start<%- locals.broadcast ? " hidden" : "" %>>
            <input type="hidden" name="back" value="<%= currentPath %>">
            <input type="hidden" name="message">
            <button class="btn btn-ghost btn-small">Site Broadcast</button>
          </form>
          <form method="post" action="/broadcast/dismiss" class="broadcast-control" data-broadcast-stop<%- locals.broadcast ? "" : " hidden" %>>
            <input type="hidden" name="back" value="<%= currentPath %>">
            <button class="btn btn-ghost btn-small">Dismiss Broadcast</button>
          </form>
        <% } %>
        <%# Account menu. <details> opens and closes without JavaScript; the script below
            just closes it on an outside click or Escape. %>
        <details class="user-menu">
          <summary class="btn btn-ghost btn-small"><span class="user-name"><%= displayName(currentUser) %></span></summary>
          <div class="user-menu-list">
            <a href="/profile"<%- currentPath.startsWith("/profile") ? ' aria-current="page"' : "" %>>Profile</a>
            <a href="/settings"<%- currentPath.startsWith("/settings") ? ' aria-current="page"' : "" %>>Settings</a>
            <form method="post" action="/logout">
              <button>Log out</button>
            </form>
          </div>
        </details>
        <script>
          (function () {
            var menu = document.currentScript.previousElementSibling;
            document.addEventListener("click", function (event) {
              if (menu.open && !menu.contains(event.target)) menu.open = false;
            });
            document.addEventListener("keydown", function (event) {
              if (event.key === "Escape" && menu.open) {
                menu.open = false;
                menu.querySelector("summary").focus();
              }
            });
          })();
        </script>
      <% } %>
    </div>
  </div>
</header>
<main class="container">
