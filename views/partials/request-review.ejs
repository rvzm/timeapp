<%# A pending edit request with Approve/Deny. Needs `request` and `back` (where to return afterwards). %>
<div class="request-head">
  <span>
    <a href="/manage/employees/<%= request.user_id %>/requests"><strong><%= request.user_name %></strong></a>
    <span class="muted small">· <%= KIND_LABELS[request.kind] %> · <%= fmt.formatDateTime(request.created_at) %></span>
  </span>
  <%- include("request-status", { request }) %>
</div>
<%- include("request-summary", { request }) %>
<p class="request-reason">Reason: <%= request.reason %></p>
<form method="post" action="/manage/requests/<%= request.id %>/review" class="request-review">
  <input type="hidden" name="back" value="<%= back %>">
  <input name="note" maxlength="500" placeholder="Note to the employee (optional)" aria-label="Review note">
  <button class="btn btn-small btn-primary" name="decision" value="approve">Approve</button>
  <button class="btn btn-small btn-ghost-danger" name="decision" value="deny">Deny</button>
</form>
