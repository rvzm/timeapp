<%# What an edit request asks for, in words. Needs `request` (a row from db/requests.js). %>
<% const punchText = (type, iso) => `${PUNCH_LABELS[type]} at ${fmt.formatDateTime(iso)}`; %>
<p class="request-summary">
  <% if (request.kind === "change") { %>
    Change <strong><%= punchText(request.original_type, request.original_timestamp) %></strong>
    to <strong><%= punchText(request.type, request.timestamp) %></strong>
  <% } else if (request.kind === "add") { %>
    Add <strong><%= punchText(request.type, request.timestamp) %></strong>
  <% } else if (request.kind === "delete") { %>
    Delete <strong><%= punchText(request.original_type, request.original_timestamp) %></strong>
  <% } else { %>
    Add a shift from <strong><%= fmt.formatDateTime(request.timestamp) %></strong>
    to <strong><%= fmt.formatDateTime(request.end_timestamp) %></strong>
  <% } %>
</p>
<%- include("request-summary-notes", { request }) %>
