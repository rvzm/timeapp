<%# The Manager Console's tabs. Needs `current`: "employees", "schedule", "requests", or "breaks".
    With several teams to view (`teamPicker`), a team picker comes first, and the tabs keep the picked team. %>
<% const pendingCount = locals.pendingRequestCount ?? 0; %>
<% const page = current === "employees" ? "/manage" : `/manage/${current}`; %>
<% const withTeam = (href) => locals.teamQuery ? `${href}?${teamQuery}` : href; %>
<% if (locals.teamPicker) { %>
  <%- include("team-picker", { picker: teamPicker, page }) %>
<% } %>
<%- include("subnav", { tabs: [
  { href: withTeam("/manage"), label: "Employees", active: current === "employees" },
  { href: withTeam("/manage/schedule"), label: "Schedule", active: current === "schedule" },
  { href: withTeam("/manage/requests"), label: pendingCount ? `Requests (${pendingCount})` : "Requests", active: current === "requests" },
  { href: withTeam("/manage/breaks"), label: "Break rules", active: current === "breaks" },
] }) %>
