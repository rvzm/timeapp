<%# One edit request as a read-only history entry: kind, status, what it asks for, reason, and review. Needs `request`. %>
<div class="request-head">
  <span>
    <strong><%= KIND_LABELS[request.kind] %></strong>
    <span class="muted small">· <%= fmt.formatDateTime(request.created_at) %></span>
  </span>
  <%- include("request-status", { request }) %>
</div>
<%- include("request-summary", { request }) %>
<% if (request.applied_timestamp || request.applied_type || request.applied_end_timestamp) { %>
  <%# Approved, but the reviewer applied something other than what was asked for. %>
  <p class="request-summary">
    Applied as
    <% if (request.kind === "add_shift") { %>
      <strong><%= fmt.formatDateTime(request.applied_timestamp ?? request.timestamp) %></strong>
      to <strong><%= fmt.formatDateTime(request.applied_end_timestamp ?? request.end_timestamp) %></strong>
    <% } else { %>
      <strong><%= PUNCH_LABELS[request.applied_type ?? request.type] %> at
      <%= fmt.formatDateTime(request.applied_timestamp ?? request.timestamp) %></strong>
    <% } %>
  </p>
<% } %>
<p class="request-reason muted">Reason: <%= request.reason %></p>
<% if (request.reviewer_name) { %>
  <p class="small">Reviewed by <%= request.reviewer_name %><% if (request.review_note) { %>: <%= request.review_note %><% } %></p>
<% } %>
