<%- include("../partials/head") %>
<%- include("../partials/nav") %>

<p class="breadcrumb"><a href="/profile">← Profile</a></p>
<div class="page-head">
  <h1>Edit profile</h1>
</div>

<section class="card">
  <% if (error) { %>
    <p class="alert alert-error"><%= error %></p>
  <% } %>

  <dl class="details">
    <dt>Username</dt><dd><code><%= account.username %></code></dd>
    <dt>Job title</dt><dd><%= account.job_title || "—" %></dd>
    <dt>Role</dt><dd><%= ROLE_LABELS[account.role] %></dd>
  </dl>
  <p class="muted small">Ask an admin to change your username, job title, or role.</p>

  <form method="post" action="/profile" class="form-grid">
    <label class="field">
      <span>Name <span class="hint">(optional)</span></span>
      <input name="display_name" value="<%= form.display_name %>" maxlength="80">
    </label>
    <label class="field">
      <span>Email <span class="hint">(optional)</span></span>
      <input type="email" name="email" value="<%= form.email %>" maxlength="120" autocomplete="email">
    </label>
    <label class="field">
      <span>Phone <span class="hint">(optional)</span></span>
      <input type="tel" name="phone" value="<%= form.phone %>" maxlength="40" autocomplete="tel">
    </label>
    <div class="form-actions field-wide">
      <button class="btn btn-primary">Save profile</button>
      <a class="btn btn-ghost" href="/profile">Cancel</a>
    </div>
  </form>
</section>

<%- include("../partials/foot") %>
