<%- include("../partials/head") %>
<%- include("../partials/nav") %>

<div class="page-head">
  <h1>Manage</h1>
</div>

<%- include("../partials/manage-tabs", { current: "requests" }) %>

<section class="card">
  <h2>Pending <span class="muted">(<%= pending.length %>)</span></h2>
  <% if (pending.length === 0) { %>
    <p class="muted">No pending requests.</p>
  <% } else { %>
    <%- include("../partials/request-groups", {
      groups: pendingGroups,
      back: teamQuery ? `/manage/requests?${teamQuery}` : "/manage/requests",
    }) %>
  <% } %>
</section>

<section class="card">
  <h2>Recently reviewed</h2>
  <% if (recent.length === 0) { %>
    <p class="muted">Nothing reviewed yet.</p>
  <% } else { %>
    <%- include("../partials/request-groups", { groups: recentGroups, back: null }) %>
  <% } %>
</section>

<%- include("../partials/foot") %>
