<%- include("../partials/head") %>
<%- include("../partials/nav") %>

<div class="page-head">
  <h1>Manage</h1>
</div>

<%- include("../partials/manage-tabs", { current: "breaks" }) %>

<section class="card">
  <h2>Default break rules</h2>
  <p class="muted">These apply to everyone without their own allowance. Leave a field blank for no limit.</p>

  <% if (notice) { %>
    <p class="alert alert-ok"><%= notice %></p>
  <% } %>
  <% if (error) { %>
    <p class="alert alert-error"><%= error %></p>
  <% } %>

  <form method="post" action="/manage/breaks" class="form-grid">
    <label class="field">
      <span>Breaks per shift</span>
      <input type="number" name="maxCount" min="0" max="20" value="<%= form.maxCount ?? "" %>" placeholder="No limit">
      <span class="hint">Start Break goes away once they're used up. 0 = no breaks.</span>
    </label>
    <label class="field">
      <span>Minutes per break</span>
      <input type="number" name="maxMinutes" min="1" max="480" value="<%= form.maxMinutes ?? "" %>" placeholder="No limit">
      <span class="hint">Longer breaks are flagged on the shift, not stopped.</span>
    </label>
    <div class="form-actions field-wide">
      <button class="btn btn-primary">Save break rules</button>
    </div>
  </form>
</section>

<section class="card">
  <h2>Custom allowances</h2>
  <% if (custom.length === 0) { %>
    <p class="muted">No one has a custom allowance. Set one from an employee's Manage page.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Employee</th><th>Breaks per shift</th><th>Minutes per break</th></tr>
        </thead>
        <tbody>
          <% custom.forEach((u) => { %>
            <tr>
              <td><a href="/manage/employees/<%= u.id %>/details"><%= displayName(u) %></a></td>
              <td><%= u.break_max_count ?? "Default" %></td>
              <td><%= u.break_max_minutes ?? "Default" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include("../partials/foot") %>
