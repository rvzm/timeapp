<%- include("../partials/head") %>
<%- include("../partials/nav") %>

<div class="page-head">
  <h1>Manage</h1>
</div>

<%- include("../partials/manage-tabs", { current: "schedule" }) %>

<section class="card">
  <div class="page-head">
    <div>
      <h2>Week of <%= fmt.formatDay(week.from) %></h2>
      <p class="muted small">To assign a shift, open an employee from the Employees tab.</p>
    </div>
    <div class="page-head-actions">
      <% const teamParam = teamQuery ? `&${teamQuery}` : ""; %>
      <a class="btn btn-small" href="/manage/schedule?week=<%= prevWeek %><%= teamParam %>">← Previous</a>
      <a class="btn btn-small btn-ghost" href="/manage/schedule<%= teamQuery ? `?${teamQuery}` : "" %>">This week</a>
      <a class="btn btn-small" href="/manage/schedule?week=<%= nextWeek %><%= teamParam %>">Next →</a>
    </div>
  </div>

  <% const back = `/manage/schedule?week=${week.from}${teamQuery ? `&${teamQuery}` : ""}`; %>
  <% days.forEach((day) => { %>
    <h3 class="schedule-day">
      <%= fmt.formatDay(day.date) %>
      <span class="muted small">· <%= day.scheduledCount %> scheduled</span>
    </h3>
    <% if (day.rows.length === 0) { %>
      <p class="muted small">No one to show for this team.</p>
    <% } else { %>
      <ul class="schedule-list schedule-roster">
        <% day.rows.forEach(({ person, assignments, availability }) => { %>
          <li class="schedule-item<%= assignments.length ? " is-scheduled" : "" %>">
            <div class="roster-person">
              <a href="/manage/employees/<%= person.id %>/schedule"><strong><%= displayName(person) %></strong></a>
              <% if (!person.active) { %><span class="badge">Inactive</span><% } %>
            </div>
            <div class="roster-detail">
              <% if (assignments.length) { %>
                <% assignments.forEach((a) => { %>
                  <div class="roster-shift">
                    <span>
                      <span class="badge badge-in">Scheduled</span>
                      <%= fmt.formatTime(a.start_at) %> – <%= fmt.formatTime(a.end_at) %>
                      <% if (a.note) { %><span class="muted small">· <%= a.note %></span><% } %>
                    </span>
                    <span class="schedule-badges">
                      <%- include("../partials/attendance", { attendance: a.attendance }) %>
                      <% if (canDelete(a)) { %>
                        <form method="post" action="/manage/schedule/<%= a.id %>/delete" class="inline"
                              data-question="Remove this assigned shift?" onsubmit="return confirm(this.dataset.question)">
                          <input type="hidden" name="back" value="<%= back %>">
                          <button class="btn btn-small btn-ghost-danger">Remove</button>
                        </form>
                      <% } %>
                    </span>
                  </div>
                <% }) %>
              <% } else { %>
                <span class="muted">
                  Availability:
                  <% if (!availability) { %>
                    not set
                  <% } else if (!availability.start) { %>
                    unavailable
                  <% } else { %>
                    <%= fmt.formatClockTime(availability.start) %> – <%= fmt.formatClockTime(availability.end) %>
                  <% } %>
                </span>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  <% }) %>
</section>

<%- include("../partials/foot") %>
