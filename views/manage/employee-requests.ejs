<%# Manage Employee: Requests tab (edit requests to review, and past ones). %>
<%- include("../partials/head") %>
<%- include("../partials/nav") %>
<%- include("../partials/employee-head", { current: "requests" }) %>

<section class="card">
  <h2>Pending requests <span class="muted">(<%= pending.length %>)</span></h2>
  <% if (pending.length === 0) { %>
    <p class="muted">No pending requests.</p>
  <% } else { %>
    <%- include("../partials/request-groups", {
      groups: pendingGroups,
      back: `/manage/employees/${target.id}/requests`,
      showEmployee: false,
    }) %>
  <% } %>
</section>

<section class="card">
  <h2>Reviewed</h2>
  <% if (reviewed.length === 0) { %>
    <p class="muted">Nothing reviewed yet.</p>
  <% } else { %>
    <%- include("../partials/request-groups", { groups: reviewedGroups, back: null, showEmployee: false }) %>
  <% } %>
</section>

<%- include("../partials/foot") %>
