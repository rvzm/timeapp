<%- include("partials/head") %>
<%- include("partials/nav") %>

<% if (error) { %>
  <p class="alert alert-error"><%= error %></p>
<% } %>

<section class="card punch-card">
  <div class="status status-<%= status %>">
    <span class="dot"></span><%= STATUS_LABELS[status] %>
  </div>

  <%# Durations marked data-live-ms keep counting in public/clock.js while data-live-running is set. %>
  <% const live = (ms, running) => `data-live-ms="${ms}"${running ? " data-live-running" : ""}`; %>
  <p class="muted status-since">
    <% if (!last) { %>
      No punches yet.
    <% } else if (status === "break") { %>
      On break since <%= fmt.formatWhen(last.timestamp) %>
      · <span <%- live(Date.now() - Date.parse(last.timestamp), true) %>><%= fmt.formatDuration(Date.now() - Date.parse(last.timestamp)) %></span>
    <% } else if (lastClock) { %>
      Last clock: <%= PUNCH_LABELS[lastClock.type] %> at <%= fmt.formatWhen(lastClock.timestamp) %>
      · <span <%- live(Date.now() - Date.parse(lastClock.timestamp), true) %>><%= fmt.formatDuration(Date.now() - Date.parse(lastClock.timestamp)) %></span> ago
    <% } else { %>
      <%= PUNCH_LABELS[last.type] %> at <%= fmt.formatWhen(last.timestamp) %>
    <% } %>
  </p>

  <div class="clock-totals">
    <% if (shiftNow) { %>
      <div class="clock-total">
        <span class="muted small">This shift</span>
        <strong <%- live(shiftNow.onClockMs, true) %>><%= fmt.formatDuration(shiftNow.onClockMs) %></strong>
        <span class="muted small">
          since <%= fmt.formatWhen(shiftNow.startedAt) %>
          <% if (shiftNow.workedMs !== null) { %>
            · worked <span <%- live(shiftNow.workedMs, status === "in") %>><%= fmt.formatDuration(shiftNow.workedMs) %></span>
            <% if (shiftNow.breakMs) { %>
              · break <span <%- live(shiftNow.breakMs, status === "break") %>><%= fmt.formatDuration(shiftNow.breakMs) %></span>
            <% } %>
          <% } %>
        </span>
      </div>
    <% } %>
    <div class="clock-total">
      <span class="muted small">This week</span>
      <strong <%- live(weekNow.workedMs, status === "in") %>><%= fmt.formatDuration(weekNow.workedMs) %></strong>
      <span class="muted small">
        since <%= fmt.formatDay(weekNow.week.from) %>
        <% if (weekNow.incompleteCount) { %>
          · <%= weekNow.incompleteCount %> shift<%= weekNow.incompleteCount === 1 ? "" : "s" %> with missing punches not counted
        <% } %>
      </span>
    </div>
  </div>

  <% if (scheduledToday.length) { %>
    <p class="small scheduled-today">
      Scheduled today:
      <%= scheduledToday.map((a) => `${fmt.formatTime(a.start_at)} – ${fmt.formatTime(a.end_at)}`).join(", ") %>
    </p>
  <% } %>

  <% const rules = breaks.policy; %>
  <% if (status !== "out" && (rules.maxCount !== null || rules.maxMinutes !== null)) { %>
    <p class="muted small break-rules">
      <% if (rules.maxCount !== null) { %>Breaks: <%= breaks.used %> of <%= rules.maxCount %> used<% } %>
      <% if (rules.maxCount !== null && rules.maxMinutes !== null) { %>·<% } %>
      <% if (rules.maxMinutes !== null) { %>up to <%= rules.maxMinutes %> min each<% } %>
    </p>
  <% } %>
  <% if (breaks.overLimit) { %>
    <p class="alert alert-warn">Your break has gone over <%= rules.maxMinutes %> minutes.</p>
  <% } %>

  <form method="post" action="/punch" class="punch-actions">
    <button class="btn btn-<%= actions[0] %>" name="action" value="<%= actions[0] %>">
      <%= PUNCH_LABELS[actions[0]] %>
    </button>
    <% if (actions[1]) { %>
      <button class="btn btn-<%= actions[1] %>" name="action" value="<%= actions[1] %>">
        <%= PUNCH_LABELS[actions[1]] %>
      </button>
    <% } %>
  </form>
</section>

<script src="/clock.js" defer></script>

<%- include("partials/foot") %>
