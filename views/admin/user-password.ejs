<%# Admin account: Password tab. %>
<%- include("../partials/head") %>
<%- include("../partials/nav") %>
<%- include("../partials/account-head", { current: "password" }) %>

<section class="card">
  <h2><%= isSelf ? "Change your password" : "Reset password" %></h2>
  <% if (saved) { %>
    <p class="alert alert-ok">
      <%= isSelf ? "Password changed. Your other devices have been logged out." : "Password reset. They have been logged out everywhere." %>
    </p>
  <% } %>
  <% if (error) { %>
    <p class="alert alert-error"><%= error %></p>
  <% } %>

  <p class="muted">
    <%= isSelf
      ? "Setting a new password logs out your other devices."
      : `Setting a new password logs ${displayName(target)} out everywhere. Let them know the new password.` %>
  </p>

  <form method="post" action="/admin/users/<%= target.id %>/password" class="form-grid">
    <label class="field">
      <span>New password</span>
      <input type="password" name="password" autocomplete="new-password" required>
    </label>
    <label class="field">
      <span>Confirm new password</span>
      <input type="password" name="confirm_password" autocomplete="new-password" required>
    </label>
    <div class="form-actions field-wide">
      <button class="btn btn-primary">Set password</button>
    </div>
  </form>
</section>

<%- include("../partials/foot") %>
