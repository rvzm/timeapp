<%# Admin: one team's name and members. %>
<%- include("../partials/head") %>
<%- include("../partials/nav") %>

<p class="breadcrumb"><a href="/admin/teams">← Teams</a></p>

<div class="page-head">
  <div>
    <h1><%= team.name %></h1>
    <p class="muted">Team created <%= fmt.formatDate(team.created_at) %></p>
  </div>
</div>

<section class="card">
  <h2>Members</h2>
  <% if (saved === "added") { %>
    <p class="alert alert-ok"><%= addedCount > 1 ? `${addedCount} members added.` : "Member added." %></p>
  <% } %>
  <% if (saved === "removed") { %>
    <p class="alert alert-ok">Member removed.</p>
  <% } %>
  <% if (memberError) { %>
    <p class="alert alert-error"><%= memberError %></p>
  <% } %>

  <% if (members.length === 0) { %>
    <p class="muted">Nobody is on this team yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>Name</th><th>Role</th><th></th></tr>
        </thead>
        <tbody>
          <% members.forEach((m) => { %>
            <tr class="<%= m.active ? "" : "row-inactive" %>">
              <td>
                <a href="/admin/users/<%= m.id %>/access"><%= displayName(m) %></a>
                <% if (m.job_title) { %><div class="muted small"><%= m.job_title %></div><% } %>
              </td>
              <td>
                <%= ROLE_LABELS[m.role] %>
                <% if (!m.active) { %><span class="badge badge-inactive">Inactive</span><% } %>
              </td>
              <td class="actions">
                <form method="post" action="/admin/teams/<%= team.id %>/members/<%= m.id %>/delete" class="inline">
                  <button class="btn btn-small btn-ghost">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <% if (candidates.length) { %>
    <div class="form-actions">
      <button type="button" class="btn btn-primary" data-open-dialog="add-members">Add members</button>
    </div>

    <%# Opened by public/team.js. The tabs filter one list, so ticks carry over between them. %>
    <dialog id="add-members" class="card modal" aria-labelledby="add-members-title">
      <form method="post" action="/admin/teams/<%= team.id %>/members" class="stack">
        <h2 id="add-members-title">Add members to <%= team.name %></h2>

        <div class="dialog-tabs" role="tablist">
          <button type="button" role="tab" aria-selected="true" data-member-filter="all">Not on this team</button>
          <button type="button" role="tab" aria-selected="false" data-member-filter="unassigned">Not on any team</button>
        </div>

        <ul class="member-list">
          <% candidates.forEach((u) => { %>
            <li<%- u.team_names ? "" : " data-unassigned" %>>
              <label class="checkbox">
                <input type="checkbox" name="user_id" value="<%= u.id %>">
                <span>
                  <%= displayName(u) %>
                  <span class="muted small">
                    <%= ROLE_LABELS[u.role] %><% if (u.movesFrom) { %> · moves from <%= u.movesFrom %><% } else if (u.team_names) { %> · also on <%= u.team_names %><% } %>
                  </span>
                </span>
              </label>
            </li>
          <% }) %>
        </ul>
        <p class="muted member-list-empty" hidden>Everyone is already on a team.</p>
        <p class="hint small muted">Employees are on one team at a time; adding one moves them here.</p>

        <div class="form-actions">
          <button class="btn btn-primary" data-member-submit>Add selected</button>
          <button type="button" class="btn btn-ghost" data-close-dialog>Cancel</button>
        </div>
      </form>
    </dialog>
    <script src="/team.js" defer></script>
  <% } %>
</section>

<section class="card">
  <h2>Team name</h2>
  <% if (saved === "renamed") { %>
    <p class="alert alert-ok">Team renamed.</p>
  <% } %>
  <% if (error) { %>
    <p class="alert alert-error"><%= error %></p>
  <% } %>
  <form method="post" action="/admin/teams/<%= team.id %>" class="form-grid">
    <label class="field">
      <span>Team name</span>
      <input name="name" value="<%= form.name %>" maxlength="60" required>
    </label>
    <div class="form-actions field-wide">
      <button class="btn btn-primary">Rename team</button>
    </div>
  </form>
</section>

<section class="card">
  <h2>Delete team</h2>
  <p class="muted">Its managers go back to managing every employee unless they're on another team. Nobody's shifts are affected.</p>
  <form method="post" action="/admin/teams/<%= team.id %>/delete" class="inline"
        data-question="Delete this team? Its members will be on no team (unless they're on another)."
        onsubmit="return confirm(this.dataset.question)">
    <button class="btn btn-danger">Delete team</button>
  </form>
</section>

<%- include("../partials/foot") %>
